{
  "ci": {
    "collect": {
      "startServerCommand": "npx vite preview --host 127.0.0.1 --port 4180 --strictPort",
      "startServerReadyPattern": "4180",
      "url": ["http://127.0.0.1:4180/Shiv-Shakti/"],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:performance": ["warn", { "minScore": 0.8 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
